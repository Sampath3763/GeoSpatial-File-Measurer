# Storage backend: "sqlite" (default local zero-dependency), "memory", or "mongodb"
DB_BACKEND=sqlite
SQLITE_DB_PATH=data/geo_measurement.db

# Optional MongoDB settings (only used if DB_BACKEND=mongodb)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=geo_measurement

# Processing Limits
MAX_UPLOAD_MB=50
MAX_UNZIPPED_MB=500
MAX_ZIP_ENTRIES=100
MAX_FEATURES_PER_FILE=50000

# Server settings
HOST=127.0.0.1
PORT=8000
